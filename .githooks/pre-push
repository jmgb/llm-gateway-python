#!/usr/bin/env bash
# Install once per clone: git config --local core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
head=$(git rev-parse HEAD)
zero=0000000000000000000000000000000000000000
changed=""
updates=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "$zero" ]] && continue
    if [[ "$(git rev-parse "$local_sha^{commit}")" != "$head" ]]; then
        echo "pre-push: check out the commit being published before validating." >&2
        exit 1
    fi
    updates=$((updates + 1))
    if [[ "$remote_sha" == "$zero" ]]; then
        changed+="$(git ls-tree -r --name-only "$head")"$'
'
    else
        if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
            echo "pre-push: remote commit missing; run git fetch first." >&2
            exit 1
        fi
        changed+="$(git diff --name-only "$remote_sha" "$head")"$'
'
    fi
done
(( updates > 0 )) || exit 0
if [[ -n "$(git status --porcelain)" ]]; then
    echo "pre-push: uncommitted changes could hide a failure in the published SHA." >&2
    exit 1
fi
printf '%s' "$changed" | bash scripts/ci-local.sh pre-push
if [[ "$(git rev-parse HEAD)" != "$head" || -n "$(git status --porcelain)" ]]; then
    echo "pre-push: HEAD or files changed during validation; validate again." >&2
    exit 1
fi
echo "pre-push: checks passed for $head"
